@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
@{
    for (int i = 0; i < 10; i++)
    {
        <p>Tabla del @i</p>
        <tabla class = "table table-bordered">
            <thead>
                <tr>
                    <th>Multiplicando</th>
                    <th>Multiplicador</th>
                    <th>Resultado</th>
                </tr>
            </thead>
            <tbody>
                @for (int j = i; j <= 10; j++)
                {
                    <tr>
                        <td>@i</td>
                        <td>@j</td>
                        <td>@(i * j)</td>
                    </tr>
                }
            </tbody>
        </tabla>
    }
}
